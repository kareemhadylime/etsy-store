# ============================================================
# Etsy Store — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----- Resend (transactional email) -----
# Create a key at https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
# Verified sender address (must match a domain verified in Resend)
RESEND_FROM_EMAIL="orders@yourdomain.com"
# Optional reply-to (defaults to RESEND_FROM_EMAIL when unset)
RESEND_REPLY_TO=""

# ----- Public site URL (canonical, sitemap, OG) -----
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ----- Server-side conversion tracking -----
# Meta CAPI: https://developers.facebook.com/docs/marketing-api/conversions-api
META_PIXEL_ID=""
META_CAPI_TOKEN=""
# GA4 Measurement Protocol: https://developers.google.com/analytics/devguides/collection/protocol/ga4
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
# TikTok Events API: https://business-api.tiktok.com/portal/docs?id=1771101303285761
TIKTOK_PIXEL_ID=""
TIKTOK_ACCESS_TOKEN=""

# ----- Etsy webhook -----
# HMAC secret used to verify incoming receipt webhooks
ETSY_WEBHOOK_SECRET=""

# ----- Storage / file delivery -----
# Supabase Storage bucket where downloadable product files live
SUPABASE_DOWNLOADS_BUCKET="downloads"
# Signed URL expiry in days
SUPABASE_DOWNLOAD_EXPIRY_DAYS="7"

# ----- Brand / shop -----
SHOP_NAME="Finance Tools"
SHOP_SUPPORT_EMAIL="support@yourdomain.com"

# ----- Etsy outbound API (for admin product sync) -----
# https://www.etsy.com/developers/your-apps
ETSY_API_KEY=""

# ----- Cron (Phase 2) -----
# Vercel automatically sends Authorization: Bearer ${CRON_SECRET} to /api/cron/*
# Also accepted as ?secret=... query param for manual curl runs in dev.
CRON_SECRET=""

# ----- Platform credentials encryption (TICKET-102) -----
# 32-byte key encoded as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates all stored OAuth tokens. Treat like a master secret.
CREDENTIALS_ENCRYPTION_KEY=""

# ----- Meta (Marketing API + CAPI) refresh credentials -----
# Long-lived System User token extension uses these. Pixel ID + CAPI token
# above are for tracking only; these are for OAuth refresh.
META_APP_ID=""
META_APP_SECRET=""

# ----- Google OAuth (GA4 Data API + Ads API + Search Console) -----
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# GA4 property ID, format "properties/123456789".
GA4_PROPERTY_ID=""
# Google Ads customer ID (10 digits, no dashes). Manager-account access OK.
GOOGLE_ADS_CUSTOMER_ID=""
# Google Ads developer token from your Manager Account API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Search Console site, e.g. "https://example.com/" or "sc-domain:example.com".
SEARCH_CONSOLE_SITE_URL=""

# ----- TikTok Business OAuth (Marketing API) -----
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ----- Anthropic (sentiment + future AI copy) -----
# https://console.anthropic.com/settings/keys
# T104 review sync falls back to a rating-based heuristic when this is unset.
ANTHROPIC_API_KEY=""

# ----- Admin alerting -----
# Where negative-review alerts and other admin notices go. Falls back to
# SHOP_SUPPORT_EMAIL when unset.
ADMIN_ALERT_EMAIL=""
